    {
      "parameters": {
        "jsCode": "const items = $input.all(); if (!items || items.length === 0 || !items[0].json.coins) { return [{ json: { formattedMessage: '⚠️ No crypto data available at this time.' } }]; } const coins = items[0].json.coins.slice(0, 5); let message = '📊 *Hourly Crypto Market Summary*\\n'; message += '━━━━━━━━━━━━━━━━━━━━\\n\\n'; message += '🔥 *Trending Cryptocurrencies*\\n\\n'; coins.forEach((item, index) => { const coin = item.item; message += `${index + 1}. *${coin.name}* (${coin.symbol})\\n`; message += `   📊 Rank: #${coin.market_cap_rank || 'N/A'}\\n`; message += `   💰 Price: $${coin.data?.price || 'N/A'}\\n`; if (coin.data?.price_change_percentage_24h) { const change = coin.data.price_change_percentage_24h.usd.toFixed(2); const emoji = change > 0 ? '📈' : '📉'; message += `   ${emoji} 24h: ${change}%\\n`; } message += '\\n'; }); message += '━━━━━━━━━━━━━━━━━━━━\\n'; message += `⏰ Updated: ${new Date().toLocaleString('en-US', { timeZone: 'UTC' })} UTC\\n`; message += '\\n_Powered by CoinGecko_'; return [{ json: { formattedMessage: message } }];"
      },
