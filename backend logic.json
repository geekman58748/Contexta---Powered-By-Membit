    {
      "parameters": {
        "jsCode": "const items = $input.all(); if (!items || items.length === 0) { return [{ json: { formattedMessage: '📰 No crypto news available at the moment.' } }]; } const data = items[0].json; const clusters = data.clusters || []; if (clusters.length === 0) { return [{ json: { formattedMessage: '📰 No crypto news clusters available at the moment.' } }]; } let message = '📰 *Trending Crypto News*\\n\\n'; clusters.slice(0, 10).forEach((cluster, index) => { const title = cluster.label || cluster.title || cluster.name || 'Unknown Topic'; const summary = cluster.summary || cluster.description || 'No summary available'; message += `${index + 1}. *${title}*\\n`; message += `   📝 ${summary}\\n\\n`; }); message += '\\n💡 Stay informed with the latest crypto trends!'; return [{ json: { formattedMessage: message } }];"
      },
      "id": "76a218f7-dee7-4e0f-9bd9-6b232c7c15b7",
