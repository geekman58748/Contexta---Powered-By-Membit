    {
      "parameters": {
        "jsCode": "const items = $input.all(); if (!items || items.length === 0) { return [{ json: { formattedMessage: '⚠️ No DeFi data available at the moment.' } }]; } const data = items[0].json; const clusters = data.clusters || []; if (clusters.length === 0) { return [{ json: { formattedMessage: '⚠️ No DeFi clusters available at the moment.' } }]; } let message = '🏦 *DeFi Market Insights*\\n\\n'; clusters.slice(0, 5).forEach((cluster, index) => { const title = cluster.label || cluster.title || cluster.name || 'Unknown Topic'; const summary = cluster.summary || cluster.description || 'No summary available'; message += `${index + 1}. *${title}*\\n`; message += `   📝 ${summary}\\n\\n`; }); message += '\\n💡 *DeFi Investment Tips:*\\n'; message += '• Diversify across multiple protocols\\n'; message += '• Check smart contract audits\\n'; message += '• Consider impermanent loss risks\\n'; message += '• Start with established protocols\\n'; message += '• Monitor APY sustainability\\n\\n'; message += '⚠️ _Always DYOR (Do Your Own Research)_'; return [{ json: { formattedMessage: message } }];"
      },
